NODE_ENV=development
PORT=8090

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=dot_domino_crm

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# App
APP_URL=http://localhost:5173
# Production: APP_URL=https://panel.trringme.com

# Google Sheets integration (one OAuth app for the whole deployment — from
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID,
# Web application type). Authorized redirect URI to register there:
# <APP_URL>/oauth/google_sheets/callback
GOOGLE_SHEETS_OAUTH_CLIENT_ID=
GOOGLE_SHEETS_OAUTH_CLIENT_SECRET=

# Security
API_TOKEN=
CRON_SECRET=
# Encrypts stored third-party credentials (SMTP passwords, WhatsApp/SMS/AI API keys, etc.)
# at rest in the database. REQUIRED in production — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, falls back to SESSION_SECRET (fine for local dev, not for production).
ENCRYPTION_KEY=

# Drip Engine
DRIP_BATCH_SIZE=50

# Lead deduplication window (hours) — leads with matching email/mobile submitted
# within this window are marked as duplicates instead of creating a new record
DEDUP_WINDOW_HOURS=24

# SMS defaults (company settings in the CRM UI override these)
SMS_PROVIDER=mshastra
SMS_MSHASTRA_URL=https://mshastra.com/sendurl.aspx
SMS_MSHASTRA_USER=
SMS_MSHASTRA_PWD=
SMS_MSHASTRA_SENDER=
SMS_MSHASTRA_COUNTRY=91
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# Upload path (absolute or relative to server directory)
UPLOAD_PATH=../uploads
