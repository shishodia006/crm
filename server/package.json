{
  "name": "dot-domino-crm-server",
  "version": "1.0.0",
  "description": "Dot Domino CRM — Express API server",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --env-file=.env --watch server.js",
    "cron": "node --env-file=.env server.js --cron",
    "backfill:mobile": "node --env-file=.env scripts/backfillMobileCountryCode.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.0",
    "imapflow": "^1.4.7",
    "mailparser": "^3.9.14",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.8",
    "nodemailer": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
